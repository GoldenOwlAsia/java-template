# Environment template for local development and Docker Compose.
# Copy to .env and fill in real values. Never commit .env.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DATABASE_USERNAME=user
DATABASE_PASSWORD=password

# --- Choose ONE database/redis target ---

# A) Docker Compose (app-api container talks to sibling services)
DATABASE_URL=jdbc:postgresql://app-postgres-db:5432/app-postgres-db
REDIS_HOST=app-redis
REDIS_PORT=6379

# B) Local ./mvnw spring-boot:run (uses published host ports)
# DATABASE_URL=jdbc:postgresql://localhost:5460/app-postgres-db
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Required in production (profile=prod). Must be >= 32 characters for HS256.
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-key-32b

MAIL_USERNAME=
MAIL_PASSWORD=

# Comma-separated SPA origins. Local default is localhost:3000 and :5173 (see application.yml).
# Production: leave empty unless the API is called from a browser on another origin.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional: override compose default (prod). Use "dev" for local debugging.
# SPRING_PROFILES_ACTIVE=dev
